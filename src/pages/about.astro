---
/*
 * /about/ moved to the site root (the academic page is the landing page now).
 * Static hosting has no server redirects, so this page forwards old links.
 */
const target = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<title>About · Redirecting…</title>
		<meta name="robots" content="noindex" />
		<link rel="canonical" href={new URL(target, Astro.site ?? Astro.url).href} />
		<meta http-equiv="refresh" content={`0; url=${target}`} />
		<script is:inline define:vars={{ target }}>location.replace(target);</script>
	</head>
	<body>
		<p><a href={target}>About</a></p>
	</body>
</html>
