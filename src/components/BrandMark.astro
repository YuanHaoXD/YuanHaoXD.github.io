---
/*
 * Brand mark — the star from the entrance animation, inked: sun-yellow fill,
 * ink outline, a cream highlight. Turns one point on hover (see global.css).
 */
interface Props {
	class?: string;
}
const { class: className } = Astro.props as Props;

const star = (cx: number, cy: number, R: number, r: number) =>
	Array.from({ length: 10 }, (_, k) => {
		const a = -Math.PI / 2 + (k * Math.PI) / 5;
		const rad = k % 2 ? r : R;
		return `${(cx + rad * Math.cos(a)).toFixed(2)},${(cy + rad * Math.sin(a)).toFixed(2)}`;
	}).join(' ');
---

<svg class:list={['brand-mark', className]} viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
	<polygon points={star(24, 26, 21, 9)} fill="#f4c64e" stroke="#231f20" stroke-width="3" stroke-linejoin="round"></polygon>
	<polygon points={star(23, 25, 12, 5.2)} fill="none" stroke="#fff6d8" stroke-width="2" stroke-linejoin="round" opacity="0.9"></polygon>
</svg>
