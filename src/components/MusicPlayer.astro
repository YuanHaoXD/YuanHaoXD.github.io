---
// 极简浮动音乐播放器 — 收起是小胶囊，展开是小卡片
---

<div id="music-player" class="music-player">
	<audio id="audio-el" preload="metadata" src="/audio/summer.mp3"></audio>

	<!-- 播放卡片（展开时显示） -->
	<div class="m-card" id="m-card">
		<div class="m-vinyl">
			<div class="m-vinyl-dot"></div>
		</div>
		<div class="m-meta">
			<div class="m-title">Summer</div>
			<div class="m-sub">菊次郎的夏天</div>
			<div class="m-progress" id="m-progress">
				<div class="m-progress-fill" id="m-fill"></div>
			</div>
			<div class="m-times">
				<span id="m-cur">0:00</span>
				<span id="m-dur">2:34</span>
			</div>
		</div>
	</div>

	<!-- 小胶囊按钮组 -->
	<div class="m-btn-group">
		<button id="m-replay" class="m-btn-sm" aria-label="重新播放" title="重新播放">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<polyline points="1 4 1 10 7 10"/>
				<path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/>
			</svg>
		</button>
		<button id="m-btn" class="m-btn" aria-label="播放音乐">
		<svg class="m-play-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
		<svg class="m-pause-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M6 5h4v14H6zm8 0h4v14h-4z"/></svg>
	</button>
</div>

<style is:global>
	#music-player {
		position: fixed;
		bottom: 1.25rem;
		right: 1.25rem;
		z-index: 9999;
	}

	/* ===== 按钮组容器 ===== */
	.m-btn-group {
		position: relative;
		z-index: 2;
		display: flex;
		align-items: center;
		gap: 0.35rem;
	}

	/* ===== 小胶囊按钮 ===== */
	.m-btn {
		position: relative;
		z-index: 2;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 50%;
		border: 1px solid rgba(0,0,0,0.06);
		background: rgba(255,255,255,0.55);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
		color: rgba(0,0,0,0.55);
		cursor: pointer;
		transition: all 0.3s cubic-bezier(0.22,1,0.36,1);
	}
	.m-btn:hover {
		background: rgba(255,255,255,0.75);
		color: rgba(0,0,0,0.8);
		transform: scale(1.05);
	}
	.m-btn:active { transform: scale(0.92); }

	/* ===== 重播按钮 ===== */
	.m-btn-sm {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 1.6rem;
		height: 1.6rem;
		border-radius: 50%;
		border: 1px solid rgba(0,0,0,0.06);
		background: rgba(255,255,255,0.5);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
		color: rgba(0,0,0,0.4);
		cursor: pointer;
		transition: all 0.3s cubic-bezier(0.22,1,0.36,1);
	}
	.m-btn-sm svg { width: 0.7rem; height: 0.7rem; }
	.m-btn-sm:hover {
		background: rgba(255,255,255,0.7);
		color: rgba(0,0,0,0.65);
		transform: scale(1.05);
	}
	.m-btn-sm:active { transform: scale(0.9); }

	html.dark .m-btn-sm {
		background: rgba(255,255,255,0.06);
		border-color: rgba(255,255,255,0.08);
		color: rgba(255,255,255,0.35);
	}
	html.dark .m-btn-sm:hover {
		background: rgba(255,255,255,0.1);
		color: rgba(255,255,255,0.6);
	}

	/* 重播按钮始终显示 */
	.m-btn-sm { display: flex !important; }

	.m-play-icon, .m-pause-icon {
		width: 0.85rem; height: 0.85rem;
	}
	.m-pause-icon { display: none; }
	.is-playing .m-play-icon { display: none; }
	.is-playing .m-pause-icon { display: block; }
	/* paused 状态：显示播放图标 */
	.is-paused .m-play-icon { display: block; }
	.is-paused .m-pause-icon { display: none; }

	/* ===== 展开卡片 ===== */
	.m-card {
		position: absolute;
		bottom: 2.75rem;
		right: 0;
		display: flex;
		gap: 0.75rem;
		padding: 0.7rem 0.85rem;
		border-radius: 1rem;
		border: 1px solid rgba(0,0,0,0.05);
		background: rgba(255,255,255,0.62);
		backdrop-filter: blur(20px);
		-webkit-backdrop-filter: blur(20px);
		box-shadow: 0 8px 28px rgba(0,0,0,0.08);
		opacity: 0;
		transform: translateY(6px) scale(0.95);
		transform-origin: bottom right;
		pointer-events: none;
		transition: all 0.3s cubic-bezier(0.22,1,0.36,1);
	}

	.is-expanded .m-card {
		opacity: 1;
		transform: translateY(0) scale(1);
		pointer-events: auto;
	}

	/* ===== 迷你黑胶 ===== */
	.m-vinyl {
		flex-shrink: 0;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 50%;
		background: radial-gradient(circle, #1a1a1a 30%, #2a2a2a 31%, #1e1e1e 33%, #252525 35%, #1c1c1c 100%);
		position: relative;
		box-shadow: inset 0 0 4px rgba(0,0,0,0.4);
	}
	.is-playing .m-vinyl {
		animation: m-spin 4s linear infinite;
	}
	@keyframes m-spin {
		to { transform: rotate(360deg); }
	}
	.m-vinyl-dot {
		position: absolute;
		top: 50%; left: 50%;
		transform: translate(-50%,-50%);
		width: 0.6rem; height: 0.6rem;
		border-radius: 50%;
		background: linear-gradient(135deg, #c08828, #e6c878);
	}

	/* ===== 歌曲信息 ===== */
	.m-meta {
		min-width: 0;
		display: flex;
		flex-direction: column;
		justify-content: center;
	}
	.m-title {
		font-size: 0.75rem;
		font-weight: 600;
		color: rgba(0,0,0,0.75);
		line-height: 1.2;
	}
	.m-sub {
		font-size: 0.6rem;
		color: rgba(0,0,0,0.35);
		line-height: 1.3;
		margin-bottom: 0.3rem;
	}

	/* ===== 迷你进度条 ===== */
	.m-progress {
		width: 7rem;
		height: 2px;
		border-radius: 1px;
		background: rgba(0,0,0,0.08);
		cursor: pointer;
	}
	.m-progress-fill {
		height: 100%;
		border-radius: 1px;
		background: linear-gradient(90deg, #c08828, #e6c878);
		width: 0%;
		transition: width 0.2s linear;
	}
	.m-times {
		display: flex;
		justify-content: space-between;
		margin-top: 0.15rem;
		font-size: 0.55rem;
		color: rgba(0,0,0,0.3);
		font-variant-numeric: tabular-nums;
	}

	/* ===== 暗色 ===== */
	html.dark .m-btn {
		background: rgba(255,255,255,0.07);
		border-color: rgba(255,255,255,0.08);
		color: rgba(255,255,255,0.5);
	}
	html.dark .m-btn:hover {
		background: rgba(255,255,255,0.12);
		color: rgba(255,255,255,0.75);
	}
	html.dark .m-card {
		background: rgba(30,30,32,0.65);
		border-color: rgba(255,255,255,0.06);
		box-shadow: 0 8px 28px rgba(0,0,0,0.2);
	}
	html.dark .m-title { color: rgba(255,255,255,0.75); }
	html.dark .m-sub { color: rgba(255,255,255,0.3); }
	html.dark .m-progress { background: rgba(255,255,255,0.08); }
	html.dark .m-times { color: rgba(255,255,255,0.25); }

	@media (max-width: 640px) {
		#music-player { bottom: 0.75rem; right: 0.75rem; }
		.m-btn { width: 2rem; height: 2rem; }
		.m-card { padding: 0.6rem 0.7rem; gap: 0.6rem; bottom: 2.5rem; }
		.m-vinyl { width: 2.2rem; height: 2.2rem; }
		.m-progress { width: 5.5rem; }
		.m-title { font-size: 0.7rem; }
	}
</style>

<script is:inline>
	(() => {
		const btn = document.getElementById('m-btn');
		const audio = document.getElementById('audio-el');
		const player = document.getElementById('music-player');
		const fill = document.getElementById('m-fill');
		const prog = document.getElementById('m-progress');
		const cur = document.getElementById('m-cur');
		const dur = document.getElementById('m-dur');

		const fmt = (s) => {
			if (!s || isNaN(s)) return '0:00';
			const m = Math.floor(s / 60);
			const sec = Math.floor(s % 60);
			return m + ':' + String(sec).padStart(2,'0');
		};

		// 三态循环：
		// 0. idle（初始）→ 点击 → playing + 卡片弹出
		// 1. playing + 卡片展开 → 点击 → playing + 卡片收回（音乐不停）
		// 2. playing + 卡片收回 → 点击 → paused（暂停）
		// 3. paused → 点击 → 回到 playing + 卡片弹出
		let state = 0; // 0=idle, 1=playing+expanded, 2=playing+collapsed, 3=paused

		btn.addEventListener('click', () => {
			switch (state) {
				case 0: // idle → 播放 + 弹出
				case 3: // paused → 播放 + 弹出
					audio.play();
					player.classList.add('is-playing');
					player.classList.remove('is-paused');
					player.classList.add('is-expanded');
					state = 1;
					break;
				case 1: // 播放+展开 → 收回（音乐不停）
					player.classList.remove('is-expanded');
					state = 2;
					break;
				case 2: // 播放+收回 → 暂停
					audio.pause();
					player.classList.remove('is-playing');
					player.classList.add('is-paused');
					player.classList.remove('is-expanded');
					state = 3;
					break;
			}
		});

		audio.addEventListener('timeupdate', () => {
			if (!audio.duration) return;
			const pct = (audio.currentTime / audio.duration) * 100;
			fill.style.width = pct + '%';
			cur.textContent = fmt(audio.currentTime);
		});

		audio.addEventListener('loadedmetadata', () => {
			dur.textContent = fmt(audio.duration);
		});

		audio.addEventListener('ended', () => {
			player.classList.remove('is-playing');
			player.classList.remove('is-paused');
			player.classList.remove('is-expanded');
			audio.currentTime = 0;
			fill.style.width = '0%';
			cur.textContent = '0:00';
			state = 0;
		});

		// 重播按钮：从头开始播放 + 弹出卡片
		const replayBtn = document.getElementById('m-replay');
		replayBtn?.addEventListener('click', (e) => {
			e.stopPropagation();
			audio.currentTime = 0;
			audio.play();
			player.classList.add('is-playing');
			player.classList.remove('is-paused');
			player.classList.add('is-expanded');
			state = 1;
		});

		prog.addEventListener('click', (e) => {
			e.stopPropagation();
			if (!audio.duration) return;
			const rect = prog.getBoundingClientRect();
			const pct = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
			audio.currentTime = pct * audio.duration;
		});
	})();
</script>
